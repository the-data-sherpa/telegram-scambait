# --- Telegram API credentials (get from https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Optional: the phone number for the account (otherwise you'll be prompted on first login)
TG_PHONE=

# --- Where to log/quarantine spam for your review ---
# Create a private channel, add nothing else, and put its numeric id or @username here.
# Leave blank to disable review logging.
REVIEW_CHAT=

# --- Behaviour ---
# dry_run = detect + log only, never actually sends bait replies (START HERE)
# live    = actually sends bait replies
MODE=dry_run

# Max bait replies to send in a single conversation before auto-stopping
MAX_BAIT_TURNS=8
# Minimum seconds to wait before replying (human-ish pacing; randomized up to 2x)
MIN_REPLY_DELAY=25

# --- LLM for generating bait replies ---
# provider: anthropic | openai | canned
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Persona the bait bot plays (a gullible, slightly confused mark)
BAIT_PERSONA=a friendly but easily-confused retiree named Gerald who is interested but keeps misunderstanding details and asking simple questions
